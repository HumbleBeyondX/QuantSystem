{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "dashboard.backend.main:app", "--port", "8002"],
      "port": 8002
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--port", "3000"],
      "port": 3000,
      "cwd": "dashboard/frontend",
      "env": {
        "NEXT_PUBLIC_API_BASE_URL": "http://localhost:8002"
      }
    }
  ]
}
