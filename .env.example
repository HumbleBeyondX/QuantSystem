# ============================================================
# QuantSystem Environment Variables
# Copy this to .env and fill in your actual values
# ============================================================

# --- Interactive Brokers ---
IB_HOST=127.0.0.1
IB_PORT=7497          # 7497=TWS Paper, 7496=TWS Live, 4002=Gateway Paper, 4001=Gateway Live
IB_CLIENT_ID=1

# --- Polygon.io ---
POLYGON_API_KEY=your_polygon_api_key_here

# --- Crypto Exchanges ---
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- TimescaleDB ---
TSDB_USER=quant
TSDB_PASSWORD=quantpass
TSDB_DB=quantdb
TSDB_HOST=localhost
TSDB_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka/Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord Alerts ---
DISCORD_WEBHOOK_URL=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Email Alerts ──
ALERT_EMAIL_SENDER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECIPIENT=humblebeyondx@gmail.com
