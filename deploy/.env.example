# QuantSystem — Environment Variables Template
# ------------------------------------------------------------
# Copy this file to the app data directory as ".env":
#   Windows:  %APPDATA%\QuantSystem\.env
#   macOS:    ~/Library/Application Support/QuantSystem/.env
#   Linux:    ~/.local/share/QuantSystem/.env
#
# The desktop app auto-creates this file on first run if missing.
# ------------------------------------------------------------

# OKX API credentials (for crypto live/paper trading via CCXT)
# Create keys at: https://www.okx.com/account/my-api
# Disable the "Withdraw" permission for safety — the app blocks it anyway.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Daily report + risk alert recipient (defaults to humblebeyondx@gmail.com
# if unset). Gmail OAuth2 credentials go in <appdata>/data/ — see
# dashboard/alerts/email_notifier.py for setup.
ALERT_EMAIL_RECIPIENT=

# Optional SMTP fallback (used only if Gmail OAuth2 is not configured)
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
ALERT_EMAIL_SENDER=
ALERT_EMAIL_PASSWORD=

# Optional: override where QuantSystem stores data/logs/configs.
# Do not set this manually — Electron sets it to app.getPath('userData').
# QS_APP_DATA_DIR=

# Optional: override backend port (default 8002). Must match Electron's
# expectations; change only if you know what you're doing.
# QS_BACKEND_PORT=8002

# ============================================================
# Cloud: Supabase (backtest results + factor data)
# ============================================================
# Free tier: 500 MB PostgreSQL + 1 GB Storage + 2 GB egress/month.
# All fields optional — if SUPABASE_URL is empty, cloud sync is disabled
# and everything falls back to local SQLite + filesystem.
#
# Setup:
#   1. Create a free project at https://supabase.com
#   2. Project Settings → API → copy Project URL and anon key
#   3. Project Settings → Database → Connection string (URI) → copy
#   4. Storage → create a private bucket named "quantsystem-artifacts"
#   5. See docs/supabase_setup.md for the full walkthrough

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

# Supabase storage bucket name (create this in Supabase → Storage)
SUPABASE_BUCKET=quantsystem-artifacts
